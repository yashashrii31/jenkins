
pipeline {
    agent any

    triggers {
        pollSCM('H/2 * * * *')
    }

    stages {
        stage('Build') {
            steps {
                echo 'Building the project...'
                sh 'python3 --version'
                sh 'python3 -m py_compile app.py test_app.py'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing the project...'
                sh 'python3 app.py'
                sh 'python3 test_app.py'
            }
        }

        stage('Success') {
            steps {
                echo 'Jenkins pipeline completed successfully!'
            }
        }
    }
}
