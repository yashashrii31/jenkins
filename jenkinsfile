4.3 Jenkinsfile
pipeline {
agent any
triggers {
pollSCM(&#39;H/2 * * * *&#39;)
}
stages {
stage(&#39;Build&#39;) {
steps {
echo &#39;Building the project...&#39;
sh &#39;python3 --version&#39;
sh &#39;python3 -m py_compile app.py test_app.py&#39;
}
}

stage(&#39;Test&#39;) {
steps {
echo &#39;Testing the project...&#39;
sh &#39;python3 app.py&#39;
sh &#39;python3 test_app.py&#39;
}
}
stage(&#39;Success&#39;) {
steps {
echo &#39;Jenkins pipeline completed successfully!&#39;
}
}
}
}